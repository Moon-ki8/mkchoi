---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_papers %}
    <h2>Related Papers</h2>
    <ul>
      {% for paper in page.related_papers %}
        <li>
          {% if paper.url %}
            {% if paper.url contains '://' %}
              <a href="{{ paper.url }}" target="_blank" rel="noopener noreferrer">{{ paper.title }}</a>
            {% else %}
              <a href="{{ paper.url | relative_url }}">{{ paper.title }}</a>
            {% endif %}
          {% else %}
            {{ paper.title }}
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
